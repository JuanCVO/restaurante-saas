DATABASE_URL=postgresql://usuario:clave@host/db?sslmode=require
JWT_SECRET=una-cadena-aleatoria-de-32-o-mas-caracteres
PORT=3001

# Opcionales
# Orígenes extra permitidos por CORS, separados por coma (por ejemplo la IP local para probar desde el celular)
# CORS_ORIGINS=http://192.168.1.50:3000
# FRONTEND_URL=https://tu-dominio.vercel.app
# Días que se conservan las órdenes archivadas. Sin esta variable no se borra nada; los cierres diarios siempre se conservan.
# ARCHIVE_RETENTION_DAYS=60
